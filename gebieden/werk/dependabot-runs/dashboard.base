filters:
  and:
    - file.inFolder("gebieden/werk/dependabot-runs")
    - agent == "debbie"
formulas:
  run: link(file, file.name.slice(0, 8))
  project: link(file, repo)
  toestand: if(status == "running", "🔄 Bezig", if(status == "paused", "⏸️ Wacht op mij", if(status == "failed", "❌ Mislukt", if(status == "resolved", "↩️ Vrijgegeven", if(aandacht.isEmpty() || issue_state == "Done", "✅ Klaar", "⚠️ Klaar, met aandachtspunten")))))
  issue_link: if(issue, link("https://crimsoncricket.myjetbrains.com/youtrack/issue/" + issue, issue), "")
  wanneer: if(started, date(started.toString().slice(0, 19).replace("T", " ")).format("dd D MMM, HH:mm"), "")
  waarom: 'if(reason, "Stap " + step + ": " + reason, aandacht.join(" · "))'
properties:
  formula.run:
    displayName: Run
  formula.project:
    displayName: Project
  formula.toestand:
    displayName: Status
  formula.issue_link:
    displayName: Issue
  formula.wanneer:
    displayName: Laatste run
  formula.waarom:
    displayName: Wat er speelt
  aandacht:
    displayName: Aandachtspunten
  resume:
    displayName: Hervatten
  kosten:
    displayName: Kosten ($)
  beurten:
    displayName: Beurten
views:
  - type: table
    name: Overzicht
    filters:
      and:
        - laatste == true
    order:
      - formula.project
      - formula.toestand
      - formula.issue_link
      - formula.wanneer
      - aandacht
    sort: []
    columnSize:
      formula.project: 220
      formula.toestand: 240
      formula.issue_link: 110
      formula.wanneer: 160
      note.aandacht: 450
  - type: table
    name: Aandacht nodig
    filters:
      and:
        - laatste == true
        - status != "resolved"
        - status != "running"
        - issue_state != "Done"
        - or:
            - status == "paused"
            - status == "failed"
            - "!aandacht.isEmpty()"
    order:
      - formula.project
      - formula.toestand
      - formula.issue_link
      - formula.waarom
      - resume
    sort:
      - property: repo
        direction: ASC
    columnSize:
      formula.project: 220
      formula.toestand: 240
      formula.issue_link: 110
      formula.waarom: 450
      note.resume: 350
  - type: table
    name: Geschiedenis
    groupBy:
      property: repo
      direction: ASC
    order:
      - formula.run
      - formula.wanneer
      - formula.toestand
      - formula.issue_link
      - beurten
      - kosten
    sort:
      - property: started
        direction: DESC
    columnSize:
      formula.run: 110
      formula.wanneer: 160
      formula.toestand: 240
      formula.issue_link: 110
      note.beurten: 90
      note.kosten: 100
