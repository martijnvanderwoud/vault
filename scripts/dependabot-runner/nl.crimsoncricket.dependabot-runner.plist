<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.crimsoncricket.dependabot-runner</string>
    <key>ProgramArguments</key>
    <array>
        <!-- launchd breidt ~ en $HOME niet uit, de shell wel: zo staan er geen absolute paden in -->
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec /usr/bin/python3 -I "$HOME/vault/scripts/dependabot_runner.py" &gt;&gt; "$HOME/dependabot-runs/.logs/runner.log" 2&gt;&amp;1</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
