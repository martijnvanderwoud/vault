<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.crimsoncricket.fien</string>
    <key>ProgramArguments</key>
    <array>
        <!-- launchd breidt ~ en $HOME niet uit, de shell wel: zo staan er geen absolute paden in -->
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p "$HOME/.fien/logs" &amp;&amp; exec /usr/bin/python3 -I "$HOME/vault/scripts/fien_runner.py" --alleen taken &gt;&gt; "$HOME/.fien/logs/runner.log" 2&gt;&amp;1</string>
    </array>
    <!-- Alleen de taak `taken`, elke maandag om 8:00 (de taak `npm` draait dagelijks via nl.crimsoncricket.fien-npm). Na slaapstand haalt launchd een gemiste run in, niet als de laptop uit stond. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
</dict>
</plist>
