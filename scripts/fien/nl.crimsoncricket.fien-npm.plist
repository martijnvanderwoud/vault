<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.crimsoncricket.fien-npm</string>
    <key>ProgramArguments</key>
    <array>
        <!-- launchd breidt ~ en $HOME niet uit, de shell wel: zo staan er geen absolute paden in -->
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p "$HOME/.fien/logs" &amp;&amp; exec /usr/bin/python3 -I "$HOME/vault/scripts/fien_runner.py" --alleen npm &gt;&gt; "$HOME/.fien/logs/npm.log" 2&gt;&amp;1</string>
    </array>
    <!-- Alleen de taak `npm`, elke dag om 8:05: vijf minuten na `taken` op maandag (nl.crimsoncricket.fien), zodat ze niet tegelijk lopen. Na slaapstand haalt launchd een gemiste run in, niet als de laptop uit stond. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
</dict>
</plist>
