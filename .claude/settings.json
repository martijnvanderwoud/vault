{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/build_index.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/build_index.py >/dev/null 2>&1; if [ -n \"$(git status --porcelain)\" ]; then git add -A && git commit -q -m \"auto: vault bijgewerkt $(date '+%Y-%m-%d %H:%M')\" >/dev/null 2>&1; fi; true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(/usr/bin/python3 -I scripts/staging_overzicht.py*)",
      "Bash(/usr/bin/python3 -I ~/vault/scripts/staging_overzicht.py*)",
      "Bash(/usr/bin/python3 -I /Users/martijn/vault/scripts/staging_overzicht.py*)",
      "Bash(/usr/bin/python3 -I scripts/staging_frontends.py --plan*)",
      "Bash(/usr/bin/python3 -I ~/vault/scripts/staging_frontends.py --plan*)",
      "Bash(/usr/bin/python3 -I /Users/martijn/vault/scripts/staging_frontends.py --plan*)",
      "Bash(/usr/bin/python3 -I scripts/staging_release_branches.py*)",
      "Bash(/usr/bin/python3 -I ~/vault/scripts/staging_release_branches.py*)",
      "Bash(/usr/bin/python3 -I /Users/martijn/vault/scripts/staging_release_branches.py*)",
      "Bash(/usr/bin/python3 -I scripts/staging_infra_pr.py*)",
      "Bash(/usr/bin/python3 -I ~/vault/scripts/staging_infra_pr.py*)",
      "Bash(/usr/bin/python3 -I /Users/martijn/vault/scripts/staging_infra_pr.py*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)"
    ]
  }
}
