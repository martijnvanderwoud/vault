{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/build_index.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git add -A && git commit -q -m \"auto: vault bijgewerkt $(date '+%Y-%m-%d %H:%M')\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
