{
  "org": "Flow-Cloud-Systems",
  "infra": "infra",
  "infra_tag": "^  tag: (?P<tag>\\S+)$",
  "versies": {
    "maven": {"bestand": "pom.xml", "regel": "^    <version>(?P<v>\\d+\\.\\d+\\.\\d+)-SNAPSHOT</version>$",
              "snapshot": ["pom.xml"]},
    "gradle": {"bestand": "gradle.properties", "regel": "^version=(?P<v>\\d+\\.\\d+\\.\\d+)-SNAPSHOT$",
               "snapshot": ["gradle.properties", "*.gradle.kts", "*/*.gradle.kts", "gradle/*.toml"]},
    "sbt": {"bestand": "build.sbt", "regel": "^ThisBuild / version := \"(?P<v>\\d+\\.\\d+\\.\\d+)-SNAPSHOT\"$",
            "snapshot": ["build.sbt", "project/*.scala", "project/*.sbt"]},
    "npm": {"bestand": "package.json"}
  },
  "images": {
    "temurin": {"hub": "library/eclipse-temurin", "tag": "25\\.\\d+\\.\\d+_\\d+-jdk",
                "huidig": "eclipse-temurin:25\\.\\d+\\.\\d+_\\d+-jdk(?:@sha256:[0-9a-f]{64})?",
                "nieuw": "eclipse-temurin:{tag}@{digest}"},
    "node": {"hub": "library/node", "tag": "24\\.\\d+\\.\\d+",
             "huidig": "(?<=^FROM )node:24(?:\\.\\d+\\.\\d+)?(?:@sha256:[0-9a-f]{64})?(?= |$)",
             "nieuw": "node:{tag}@{digest}"},
    "node-slim": {"hub": "library/node", "tag": "24\\.\\d+\\.\\d+-slim",
                  "huidig": "(?<=^FROM )node:24(?:\\.\\d+\\.\\d+)?-slim(?:@sha256:[0-9a-f]{64})?(?= |$)",
                  "nieuw": "node:{tag}@{digest}"},
    "nginx-alpine": {"hub": "library/nginx", "tag": "1\\.\\d+\\.\\d+-alpine",
                     "huidig": "(?<=^FROM )nginx:(?:1\\.\\d+\\.\\d+-)?alpine(?:@sha256:[0-9a-f]{64})?(?= |$)",
                     "nieuw": "nginx:{tag}@{digest}"}
  },
  "repos": [
    {"repo": "ats", "rol": "image", "infra": "helm/vars/dev/staging/web-app-ats/values.yaml",
     "versie": "maven", "image": {"bestand": "pom.xml", "soort": "temurin"}},
    {"repo": "cata", "rol": "image", "infra": "helm/vars/dev/staging/web-app-cata/values.yaml",
     "versie": "maven", "image": {"bestand": "pom.xml", "soort": "temurin"}},
    {"repo": "iam", "rol": "image", "infra": "helm/vars/dev/staging/web-app-iam/values.yaml",
     "versie": "maven", "image": {"bestand": "pom.xml", "soort": "temurin"},
     "frontends": {"iam.login-ui.version": "iam-login-ui"}},
    {"repo": "iam-login-ui", "rol": "frontend", "in": "iam"},
    {"repo": "insights", "rol": "image", "infra": "helm/vars/dev/staging/web-app-insights/values.yaml",
     "versie": "gradle",
     "image": {"bestand": "application/build.gradle.kts", "soort": "temurin"}},
    {"repo": "more", "rol": "image", "infra": "helm/vars/dev/staging/web-app-more/values.yaml",
     "versie": "maven", "image": {"bestand": "pom.xml", "soort": "temurin"}},
    {"repo": "notifications", "rol": "image", "infra": "helm/vars/dev/staging/notifications/values.yaml",
     "versie": "sbt", "image": {"bestand": "build.sbt", "soort": "temurin"}},
    {"repo": "portal", "rol": "image", "infra": "helm/vars/dev/staging/web-app-portal/values.yaml",
     "versie": "maven", "image": {"bestand": "pom.xml", "soort": "temurin"},
     "frontends": {"ui.employee.version": "portal-employee-ui", "ui.worker.version": "portal-worker-ui",
                   "ui.enrollment.version": "portal-enrollment-ui"}},
    {"repo": "portal-ui-common", "rol": "frontend", "in": "portal-employee-ui portal-worker-ui"},
    {"repo": "portal-employee-ui", "rol": "frontend", "in": "portal"},
    {"repo": "portal-enrollment-ui", "rol": "frontend", "in": "portal"},
    {"repo": "portal-worker-ui", "rol": "frontend", "in": "portal"},
    {"repo": "profile-presentation-ui", "rol": "image", "infra": "helm/vars/dev/staging/profile-presentation-ui/values.yaml",
     "versie": "npm",
     "image": {"bestand": "Dockerfile", "soort": "node-slim"}},
    {"repo": "roep", "rol": "image", "infra": "helm/vars/dev/staging/web-app-roep/values.yaml",
     "versie": "maven", "image": {"bestand": "pom.xml", "soort": "temurin"}},
    {"repo": "rostering-api", "rol": "image", "infra": "helm/vars/dev/staging/rostering-api/values.yaml",
     "versie": "npm", "image": {"bestand": "Dockerfile", "soort": "node"}},
    {"repo": "rostering-application", "rol": "image", "infra": "helm/vars/dev/staging/rostering-application/values.yaml",
     "versie": "gradle",
     "image": {"bestand": "application/build.gradle.kts", "soort": "temurin"}},
    {"repo": "rostering-engine", "rol": "image", "infra": "helm/vars/dev/staging/rostering-engine/values.yaml",
     "versie": "gradle",
     "image": {"bestand": "application/build.gradle.kts", "soort": "temurin"}},
    {"repo": "rostering-ui", "rol": "image", "infra": "helm/vars/dev/staging/rostering-ui/values.yaml",
     "versie": "npm", "image": {"bestand": "Dockerfile", "soort": "nginx-alpine"}}
  ]
}
